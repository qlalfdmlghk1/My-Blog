# ─────────────────────────────────────────────
# Firebase 클라이언트 SDK (브라우저 노출됨 — 공개되어도 무해)
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정
# ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────
# Firebase Admin SDK (서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것)
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# PRIVATE_KEY 는 줄바꿈을 \n 리터럴로 넣고 전체를 따옴표로 감싼다
# ─────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ─────────────────────────────────────────────
# 관리자 — 계정 1개(본인). Firebase Auth 콘솔의 사용자 UID
# 클라이언트 가드용(NEXT_PUBLIC_)과 서버 검증용을 같은 값으로 둔다.
# 클라이언트 값은 UI 가드일 뿐이고 최종 방어선은 Firestore 보안 규칙 + 서버 검증이다.
# ─────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_UID=
ADMIN_UID=

# ─────────────────────────────────────────────
# 사이트
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
