# ─────────────────────────────────────────────
# Firebase 클라이언트 SDK (브라우저 노출됨 — 공개되어도 무해)
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정
# ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────
# Firebase Admin SDK (서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것)
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# PRIVATE_KEY 는 줄바꿈을 \n 리터럴로 넣고 전체를 따옴표로 감싼다
# ─────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ─────────────────────────────────────────────
# 관리자 — 계정 1개(본인). Firebase Auth 콘솔의 사용자 UID.
# 관리자 판별은 커스텀 클레임(admin: true)으로 하고, 이 값은 클레임을 부여할
# 대상을 가리키는 용도로만 쓴다: npm run admin:claim
# 보안 규칙과 서버 검증은 UID 가 아니라 클레임을 본다.
# ─────────────────────────────────────────────
ADMIN_UID=

# ─────────────────────────────────────────────
# 사이트
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Vercel Blob (에디터 이미지 업로드) ──
# Vercel 대시보드 > Storage > 해당 Blob 스토어 > .env.local 탭에서 복사.
# 배포본에는 스토어를 프로젝트에 연결(Connect to Project)하면 자동 주입되므로,
# 이 값은 로컬 개발용이다. 서버 전용 — NEXT_PUBLIC_ 을 붙이지 말 것.
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------
# Gemini (발행 확인 화면의 용어 추출)
# https://aistudio.google.com/apikey 에서 발급.
# 서버 전용 - NEXT_PUBLIC_ 을 붙이면 브라우저 번들에 실려 키가 공개된다.
# 없으면 추출 버튼만 동작하지 않고 발행 흐름은 그대로 돌아간다.
# -----------------------------------------------
GEMINI_API_KEY=
# 모델을 바꾸고 싶을 때만 (비우면 gemini-2.5-flash)
GEMINI_MODEL=
# 발행 확인 화면의 커버 생성이 쓰는 이미지 모델 (비우면 gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=

# -----------------------------------------------
# 익명 댓글 — 도배 제한용 IP 해시 salt
# 아무 긴 무작위 문자열(32자 이상 권장). `openssl rand -hex 32` 등으로 생성.
# 서버 전용 - NEXT_PUBLIC_ 을 붙이지 말 것.
#
# IP 원문은 저장하지 않고 이 값을 섞은 해시만 남긴다. salt 없이 해시하면
# IPv4 주소 43억 개를 전부 미리 계산해 역산할 수 있어 의미가 없다.
# 값을 바꾸면 기존 해시와 안 맞아 쿨다운이 한 번씩 풀린다(1시간 뒤 정리된다).
# 없으면 도배 제한만 꺼지고 나머지 필터는 그대로 동작한다.
# -----------------------------------------------
COMMENT_IP_SALT=...
