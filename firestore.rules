rules_version = '2';

// 클라이언트 검증에 의존하지 않는다 — 이 규칙이 최종 방어선이다.
//
// 관리자 판별은 커스텀 클레임으로 한다. UID 를 규칙에 박지 않는 이유:
//  - 규칙 파일이 정적이 되어 배포 전 치환 단계가 사라진다
//  - 관리자를 바꾸거나 늘릴 때 규칙 재배포가 필요 없다
//  - 저장소에 특정 계정 식별자가 남지 않는다
// 클레임 부여: npm run admin:claim (scripts/set-admin-claim.mjs)
service cloud.firestore {
  function isAdmin() {
    return request.auth != null
        && request.auth.token.admin == true;
  }

  // 카테고리가 관리 화면에서 만들어지므로 이 규칙 파일에 slug 를 박아둘 수 없다.
  // 대신 실제로 그 카테고리 문서가 있는지 확인한다 — 목록을 두 곳에 적어두면
  // 카테고리를 하나 만들 때마다 규칙을 다시 배포해야 하고, 잊으면 저장이 막힌다.
  // (문서 읽기 1회가 붙지만 글 쓰기는 관리자만 하는 드문 동작이다)
  function categoryExists(database, slug) {
    return exists(/databases/$(database)/documents/categories/$(slug));
  }

  function validPost(database, d) {
    return d.keys().hasAll(['slug', 'title', 'content', 'status', 'category', 'tags'])
        && d.slug is string && d.slug.size() > 0 && d.slug.size() < 200
        && d.title is string && d.title.size() < 300
        && d.content is string
        && d.status in ['draft', 'published']
        && d.category is string && d.category.size() > 0 && d.category.size() < 100
        && categoryExists(database, d.category)
        && d.tags is list && d.tags.size() <= 20;
  }

  function validCategory(d) {
    return d.keys().hasAll(['name', 'hint', 'palette', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() < 60
        && d.hint is string && d.hint.size() < 200
        // 팔레트 슬롯은 코드에 고정된 12개다 — 카테고리와 달리 사람이 늘리지 않으므로
        // 여기 적어두는 비용이 없고, 임의의 문자열이 CSS 변수 이름에 섞이는 걸 막는다
        && d.palette in ['coral', 'blue', 'purple', 'amber', 'teal', 'pink',
                         'lime', 'cyan', 'rose', 'indigo', 'brown', 'slate']
        && d.order is number;
  }

  match /databases/{database}/documents {
    match /posts/{postId} {
      // published 글만 공개 읽기. draft 는 관리자만.
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && validPost(database, request.resource.data);
      allow update: if isAdmin() && validPost(database, request.resource.data);
      allow delete: if isAdmin();
    }

    match /categories/{categorySlug} {
      // 분류 체계는 공개 정보다 — 사이드바가 로그인 없이 읽는다.
      allow read: if true;
      allow create, update: if isAdmin() && validCategory(request.resource.data);
      // 글이 남아 있는 카테고리의 삭제는 관리 화면이 막는다. 규칙에서 막으려면
      // 그 카테고리를 참조하는 글이 없음을 확인해야 하는데, 보안 규칙은 집계
      // 쿼리를 할 수 없다. 쓰기 권한 자체가 관리자로 한정돼 있어 이 경계는
      // "권한"이 아니라 "실수 방지"의 문제이고, 실수 방지는 화면이 맡는다.
      allow delete: if isAdmin();
    }

    // 명시하지 않은 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
