rules_version = '2';

// 클라이언트 검증에 의존하지 않는다 — 이 규칙이 최종 방어선이다.
//
// 관리자 판별은 커스텀 클레임으로 한다. UID 를 규칙에 박지 않는 이유:
//  - 규칙 파일이 정적이 되어 배포 전 치환 단계가 사라진다
//  - 관리자를 바꾸거나 늘릴 때 규칙 재배포가 필요 없다
//  - 저장소에 특정 계정 식별자가 남지 않는다
// 클레임 부여: npm run admin:claim (scripts/set-admin-claim.mjs)
service cloud.firestore {
  function isAdmin() {
    return request.auth != null
        && request.auth.token.admin == true;
  }

  // 카테고리가 관리 화면에서 만들어지므로 이 규칙 파일에 slug 를 박아둘 수 없다.
  // 대신 실제로 그 카테고리 문서가 있는지 확인한다 — 목록을 두 곳에 적어두면
  // 카테고리를 하나 만들 때마다 규칙을 다시 배포해야 하고, 잊으면 저장이 막힌다.
  // (문서 읽기 1회가 붙지만 글 쓰기는 관리자만 하는 드문 동작이다)
  function categoryExists(database, slug) {
    return exists(/databases/$(database)/documents/categories/$(slug));
  }

  // 소분류는 카테고리 문서의 하위 컬렉션에 있다. 경로가 곧 소속이므로
  // 이 한 번의 확인이 "존재하는가"와 "그 카테고리 소속인가"를 동시에 만족시킨다 —
  // 소분류에 부모 필드를 두고 그걸 대조했다면 필드가 위조될 수 있었다.
  function subcategoryExists(database, category, sub) {
    return exists(/databases/$(database)/documents/categories/$(category)/subcategories/$(sub));
  }

  function validPost(database, d) {
    return d.keys().hasAll(['slug', 'title', 'content', 'status', 'category', 'subcategory', 'tags'])
        && d.slug is string && d.slug.size() > 0 && d.slug.size() < 200
        && d.title is string && d.title.size() < 300
        && d.content is string
        && d.status in ['draft', 'published']
        && d.category is string && d.category.size() > 0 && d.category.size() < 100
        && categoryExists(database, d.category)
        // 소분류는 **선택 사항**이다. 빈 문자열 = 소분류 없음.
        //
        // 필수로 두면 카테고리에 소분류가 아직 하나도 없을 때 그 카테고리로는 글을
        // 아예 못 쓴다. 소분류를 지운 뒤 남은 글도 같은 이유로 수정이 막혔다 —
        // 값은 남아 있는데 가리키는 문서가 없어 subcategoryExists() 에 걸렸다.
        //
        // 다만 값이 들어 있다면 실재하는 소분류여야 한다. 소분류는 글의 주소를 이루므로
        // (`/categories/{slug}/{sub}`) 없는 값을 가리키면 죽은 링크가 생긴다.
        // 비어 있는 글은 사이드바에서 '분류 없음'으로 모인다(lib/posts.ts 의 looseCount).
        && d.subcategory is string && d.subcategory.size() < 100
        && (d.subcategory == '' || subcategoryExists(database, d.category, d.subcategory))
        && d.tags is list && d.tags.size() <= 20;
  }

  function validCategory(d) {
    return d.keys().hasAll(['name', 'hint', 'palette', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() < 60
        && d.hint is string && d.hint.size() < 200
        // 팔레트 슬롯은 코드에 고정된 12개다 — 카테고리와 달리 사람이 늘리지 않으므로
        // 여기 적어두는 비용이 없고, 임의의 문자열이 CSS 변수 이름에 섞이는 걸 막는다
        && d.palette in ['coral', 'blue', 'purple', 'amber', 'teal', 'pink',
                         'lime', 'cyan', 'rose', 'indigo', 'brown', 'slate']
        && d.order is number;
  }

  // 용어 사전. 정의문은 길이만 제한한다 — 내용 검사는 규칙이 할 수 있는 일이 아니다.
  // aliases 는 본문 자동 링크가 훑는 목록이라 개수를 묶어둔다. 열어두면 표기 수천 개가
  // 든 문서 하나로 글 렌더링마다 거대한 정규식이 만들어진다.
  function validDictionaryTerm(d) {
    return d.keys().hasAll(['term', 'aliases', 'definition', 'postSlug', 'category'])
        && d.term is string && d.term.size() > 0 && d.term.size() < 80
        && d.aliases is list && d.aliases.size() <= 10
        && d.definition is string && d.definition.size() > 0 && d.definition.size() < 600
        // 빈 문자열 = 연결된 글 없음. 여기서 글의 존재까지 확인하지는 않는다 —
        // 초안 상태의 글을 미리 이어둘 수 있어야 하고, 끊긴 링크는 404 로 끝난다.
        && d.postSlug is string && d.postSlug.size() < 200
        // 분류는 **선택 사항**이다. 빈 문자열 = 분류 없음.
        //
        // 필수로 두면 용어를 만드는 순간 분류까지 정하도록 강요하게 되는데, 글을 쓰다
        // 발견한 낱말을 급히 넣는 자리에서는 어디에 속하는지 아직 모르는 편이 흔하다.
        // 그때 강요하면 아무 분류나 고르게 되고, 그렇게 들어간 값이 나중에 진짜 분류처럼
        // 보인다. 비워 두면 사전에서 '분류 없음'으로 모여 나중에 손볼 대상이 드러난다.
        //
        // 존재까지는 확인하지 않는다 — 글은 분류가 URL(`/categories/{slug}`)을 이루므로
        // 없는 값을 가리키면 죽은 링크가 생기지만, 용어의 분류는 사전 안의 필터 축일 뿐이라
        // 없는 값을 가리켜도 '분류 없음'으로 떨어질 뿐이다. exists() 를 걸면 분류를 지운 뒤
        // 그 분류를 쓰던 용어의 수정 자체가 막혀, 고치려는 사람이 손댈 수단을 잃는다.
        && d.category is string && d.category.size() < 100;
  }

  // 용어 분류 — 글 카테고리와 같은 규약(슬롯 ID 로 색 저장)을 따르되 별개 컬렉션이다.
  // 팔레트 슬롯 목록은 코드에 고정된 12개이므로 여기 적어두는 비용이 없고,
  // 임의의 문자열이 CSS 변수 이름에 섞이는 걸 막는다 (validCategory 와 같은 이유).
  function validDictionaryCategory(d) {
    return d.keys().hasAll(['name', 'palette', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() < 60
        && d.palette in ['coral', 'blue', 'purple', 'amber', 'teal', 'pink',
                         'lime', 'cyan', 'rose', 'indigo', 'brown', 'slate']
        && d.order is number;
  }

  function validSubcategory(d) {
    return d.keys().hasAll(['name', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() < 60
        && d.order is number;
  }

  match /databases/{database}/documents {
    match /posts/{postId} {
      // published 글만 공개 읽기. draft 는 관리자만.
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && validPost(database, request.resource.data);
      allow update: if isAdmin() && validPost(database, request.resource.data);
      allow delete: if isAdmin();
    }

    match /categories/{categorySlug} {
      // 분류 체계는 공개 정보다 — 사이드바가 로그인 없이 읽는다.
      allow read: if true;
      allow create, update: if isAdmin() && validCategory(request.resource.data);

      match /subcategories/{subSlug} {
        allow read: if true;
        allow create, update: if isAdmin() && validSubcategory(request.resource.data);
        // 글이 남아 있는 소분류의 삭제는 카테고리와 같은 이유로 화면이 막는다
        allow delete: if isAdmin();
      }
      // 글이 남아 있는 카테고리의 삭제는 관리 화면이 막는다. 규칙에서 막으려면
      // 그 카테고리를 참조하는 글이 없음을 확인해야 하는데, 보안 규칙은 집계
      // 쿼리를 할 수 없다. 쓰기 권한 자체가 관리자로 한정돼 있어 이 경계는
      // "권한"이 아니라 "실수 방지"의 문제이고, 실수 방지는 화면이 맡는다.
      allow delete: if isAdmin();
    }

    match /dictionaryCategories/{categorySlug} {
      // 분류는 공개 정보다 — 사전 페이지의 필터가 로그인 없이 읽는다.
      allow read: if true;
      allow create, update: if isAdmin() && validDictionaryCategory(request.resource.data);
      // 소속 용어가 남았는지는 관리 화면이 막는다 (규칙은 집계 질의를 할 수 없다).
      // 실수로 지워도 용어가 사라지지는 않고 미분류로 떨어진다.
      allow delete: if isAdmin();
    }

    match /dictionary/{termSlug} {
      // 용어 정의는 공개 정보다 — 사전 페이지와 본문 링크가 로그인 없이 읽는다.
      allow read: if true;
      allow create, update: if isAdmin() && validDictionaryTerm(request.resource.data);
      // 지운 용어를 가리키던 본문 링크는 사전 페이지의 빈 앵커로 떨어질 뿐이라
      // 카테고리처럼 "글이 남아 있는지" 확인할 필요가 없다.
      allow delete: if isAdmin();
    }

    // collectionGroup('subcategories') 조회용. 위의 중첩 match 는 경로가 고정된
    // 읽기만 허용하므로, 컬렉션 그룹 질의는 이 재귀 match 가 따로 열어줘야 한다.
    // 쓰기는 열지 않는다 — 쓰기는 위의 카테고리 하위 경로에서만 가능하다.
    match /{path=**}/subcategories/{subSlug} {
      allow read: if true;
    }

    // 명시하지 않은 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
